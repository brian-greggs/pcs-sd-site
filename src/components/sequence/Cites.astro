---
// What the official pages say, in their words: one quote per citation, with the page, its incentive label and
// the date it was saved; then any older guidance that says otherwise and why it isn't used. It sits inside a
// closed "Details and official wording" (step cards, form rows) or a closed section, so it opens with that tap.
// `data-official-quote` marks the verbatim quote itself: the demographic word check skips only these blockquotes,
// and only when the text is a quote in the sequence export (Brian 2026-10-22, F2-23).
import ExtLink from '../ExtLink.astro';

type Cite = { title: string; agency: string; url: string; incentive: string; retrieved_on: string; quote: string; reason?: string };
interface Props { sources: Cite[]; superseded?: Cite[]; src: string }
const { sources, superseded = [], src } = Astro.props;
---

<div class="cites" data-src={src}>
  <p class="cites-head">What the official pages say</p>
  <ul class="quotes">
    {sources.map((c) => (
      <li data-cite>
        <blockquote data-official-quote>“{c.quote}”</blockquote>
        <span class="cite-from"><ExtLink href={c.url} incentive={c.incentive} text={`${c.agency}, ${c.title}`} src={src} /> · retrieved {c.retrieved_on}</span>
      </li>
    ))}
  </ul>
  {superseded.length > 0 && (
    <>
      <p class="cites-head">Older guidance that says otherwise (not used)</p>
      <ul class="quotes">
        {superseded.map((c) => (
          <li data-superseded>
            <blockquote data-official-quote>“{c.quote}”</blockquote>
            <span class="cite-from"><ExtLink href={c.url} incentive={c.incentive} text={`${c.agency}, ${c.title}`} src={src} /> · retrieved {c.retrieved_on}</span>
            <span class="cite-why">{c.reason}</span>
          </li>
        ))}
      </ul>
    </>
  )}
</div>
