---
// The BAH for the reader's base and pay band (Brian 2026-10-20): one line per grade in the band, with
// dependents first and without second, under the label "2026 BAH, <area> area (MHA <code>)". Every
// MHA and band is rendered and the page shows one (data-mha for the base, data-band-show for the band),
// so the checks read every figure and the page works with JavaScript off. data-bah-block, data-bah-label
// and data-bah mark the figures for the bah-figures check (scripts/check_principles.mjs). The section
// this sits in must carry the BAH date and source in its date line.
import { dollars } from '../lib/format';
import { bahKey, type BahArea } from '../lib/bah';

interface Props {
  areas: BahArea[];
  bands: string[];
  mha: string; // shown by default: the MHA of the page's default base
  band: string;
}
const { areas, bands, mha, band } = Astro.props;
---

{areas.map((a) => (
  <div class="bah-area" data-mha={a.mha} data-mha-bases={a.bases.join(' ')} data-bah-block={`${a.year}|${a.mha}`} hidden={a.mha !== mha}>
    <p class="bah-label" data-bah-label>{a.label}</p>
    {bands.map((b) => (
      <ul class="bah-lines" data-band-show={b} hidden={b !== band}>
        {a.rows.filter((r) => r.pay_band === b).map((r) => (
          <li data-bah={bahKey(r)}><strong>{r.grade}</strong>: {dollars(r.with_dependents)} with dependents, {dollars(r.without_dependents)} without dependents</li>
        ))}
      </ul>
    ))}
  </div>
))}

<script>
  // ?base=<slug> (from a base page) picks the MHA shown. Without it, the page's default base.
  const base = new URLSearchParams(location.search).get('base');
  const blocks = [...document.querySelectorAll<HTMLElement>('[data-mha-bases]')];
  if (base && blocks.some((el) => el.dataset.mhaBases!.split(' ').includes(base))) {
    blocks.forEach((el) => { el.hidden = !el.dataset.mhaBases!.split(' ').includes(base); });
  }
</script>
