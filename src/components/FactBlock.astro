---
// A section of facts, in three layers (Brian 2026-10-23): the summary line (always visible), the body (one tap:
// a native <details>, closed by default) and the receipts (a SourceChip as the section's last element, with the
// source, the dates and the license). `plain` renders an always-open card instead (sequence steps, /sources/).
//
// Every fact in the section names its source with data-src (the summary line with `summarySrc`); the chip lists
// those keys (`srcs`) and the date line that covers them. scripts/check_principles.mjs (`dated`) fails a section
// with a fact that names no source, a source the chip doesn't list, or a chip date that isn't the source's own.
import SourceChip from './SourceChip.astro';

interface Props {
  id: string;
  title: string;
  asOf: string; // e.g. "HUD FY2027 · verified 2026-09-18"
  source: string;
  srcs: string[];
  more?: string[]; // extra dated lines for the chip (SourceChip)
  summary?: string;
  summarySrc?: string; // the source keys of the facts in the summary line
  plain?: boolean;
  level?: 2 | 3; // 3 for a group inside a page section (base pages)
  chip?: string; // show the title as a tier chip (a map-tier-* class: the base page's drive groups)
}
const { id, title, asOf, source, srcs, more, summary, summarySrc, plain = false, level = 2, chip } = Astro.props;
const H = level === 3 ? 'h3' : 'h2';
if (!asOf.trim()) throw new Error(`FactBlock "${id}" has no date`);
if (!plain && !summary?.trim() && !Astro.slots.has('summary')) throw new Error(`FactBlock "${id}" has no summary line`);
if (!plain && !summarySrc) throw new Error(`FactBlock "${id}": the summary line names no source (summarySrc)`);
---

{plain ? (
  <section class="fact plain" id={id} data-fact={id}>
    <h2>{title}</h2>
    <slot />
    <SourceChip asOf={asOf} source={source} srcs={srcs} more={more}><slot name="receipts" /></SourceChip>
  </section>
) : (
  <section class="fact" id={id} data-fact={id}>
    <details>
      <summary><H>{chip ? <span class={`chip ${chip}`}>{title}</span> : title}</H><span class="summary-line" data-src={summarySrc}><slot name="summary">{summary}</slot></span></summary>
      <div class="body">
        <slot />
      </div>
    </details>
    <SourceChip asOf={asOf} source={source} srcs={srcs} more={more}><slot name="receipts" /></SourceChip>
  </section>
)}
