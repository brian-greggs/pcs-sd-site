---
// Public schools with an address in these zips, their districts, and the Dashboard facts.
import { getCollection, getEntry } from 'astro:content';
import FactBlock from '../FactBlock.astro';
import MethodHint from '../MethodHint.astro';
import ExtLink from '../ExtLink.astro';
import { pct, STATUS_LABEL } from '../../lib/format';
import { provenance } from '../../lib/prov';

interface Props { zips: string[] }
const { zips } = Astro.props;
const { asOf } = await provenance();
const LEVELS = ['elementary', 'middle', 'high', 'k12'];
const schools = (await getCollection('schools')).map((r) => r.data).filter((s) => zips.includes(s.zip))
  .sort((a, b) => LEVELS.indexOf(a.level) - LEVELS.indexOf(b.level) || a.school.localeCompare(b.school));
const districtNames = [...new Set(schools.filter((s) => s.charter === 'N').map((s) => s.district))];
const districts = (await Promise.all(districtNames.map((d) => getEntry('districts', d)))).filter((d) => !!d);
const districtLine = districtNames.length ? `${districtNames[0]}${districtNames.length > 1 ? ` +${districtNames.length - 1} more` : ''}` : 'No district found';
const summary = `${districtLine} · ${schools.length} public ${schools.length === 1 ? 'school' : 'schools'} in ${zips.length > 1 ? 'these zips' : 'the zip'}`;
---

<FactBlock id="schools" title="Schools" summary={summary} summarySrc="prov:schools" srcs={['prov:schools', ...(districts.length ? ['prov:districts'] : []), 'link:slo-navy-san-diego', 'link:slo-mcas-miramar']} asOf={asOf('schools')} source="California Department of Education: school directory, CA School Dashboard 2025, CAASPP 2024–25">
  {districts.map((d) => (
    <dl class="facts" data-src="prov:districts">
      <dt>District</dt>
      <dd>{d.id}</dd>
      <dt>Which school is yours</dt>
      <dd>{d.data.boundary_url ? <ExtLink href={d.data.boundary_url} incentive="Public school district" text="District boundary lookup" src="prov:districts" /> : <span class="muted">Boundary lookup not yet found; ask the district.</span>}</dd>
      <dt>Transfers</dt>
      <dd>{d.data.transfer_url ? <ExtLink href={d.data.transfer_url} incentive="Public school district" text="District transfer policy" src="prov:districts" /> : <span class="muted">Transfer page not yet found.</span>}</dd>
    </dl>
  ))}
  {districts.length === 0 && <p class="gap" data-src="prov:schools">No school district found for {zips.length > 1 ? 'these zips' : 'this zip'} in our data. The School Liaison Officers below can tell you which district serves an address.</p>}
  <p class="note" data-src="prov:schools">These are the public schools with an address in {zips.length > 1 ? 'these zips' : 'this zip'}. Your assigned school depends on your street, so check the boundary lookup before you sign a lease.</p>
  {schools.length > 0 ? (
    <div class="table-wrap" data-src="prov:schools">
      <table>
        <thead>
          <tr><th>School</th><th>Grades</th><th>English (Dashboard)</th><th>Math (Dashboard)</th><th class="num">Met English standard</th><th class="num">Met math standard</th><th class="num">Chronically absent</th><th>Elsewhere</th></tr>
        </thead>
        <tbody>
          {schools.map((s) => (
            <tr>
              <td>{s.school}{s.charter === 'Y' && <span class="muted"> (charter)</span>}</td>
              <td>{s.grades}</td>
              <td>{s.ela_dfs_statuslevel ? STATUS_LABEL[s.ela_dfs_statuslevel] : '—'}</td>
              <td>{s.math_dfs_statuslevel ? STATUS_LABEL[s.math_dfs_statuslevel] : '—'}</td>
              <td class="num">{pct(s.caaspp_ela_pct_met)}</td>
              <td class="num">{pct(s.caaspp_math_pct_met)}</td>
              <td class="num">{pct(s.chronic_abs_pct, 1)}</td>
              <td>{s.greatschools_url ? <ExtLink href={s.greatschools_url} incentive="Nonprofit: ad-supported" text="GreatSchools" src="prov:schools" /> : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <p class="note" data-src="prov:schools">No public school has an address in {zips.length > 1 ? 'these zips' : 'this zip'}. The boundary lookup for the district still decides which school is yours.</p>
  )}
  <MethodHint topic="schools" text="What the Dashboard levels and dashes mean:" />
  <p class="note" data-src="link:slo-navy-san-diego link:slo-mcas-miramar">Moving mid-year, or need help with enrollment? The School Liaison Officers are free:</p>
  <ul class="links" data-src="link:slo-navy-san-diego link:slo-mcas-miramar"><li>Navy: <ExtLink id="slo-navy-san-diego" /></li><li>Marine Corps: <ExtLink id="slo-mcas-miramar" /></li></ul>
</FactBlock>
