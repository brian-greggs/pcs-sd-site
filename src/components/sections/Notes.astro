---
// The human-written lead or gotchas. Renders nothing unless there's real content
// (see src/lib/notes.ts). `srcKey` (notes:<collection>/<slug>) dates the gotchas by the file's verified_on.
import FactBlock from '../FactBlock.astro';
import { writtenNotes } from '../../lib/notes';

interface Props {
  notes: Awaited<ReturnType<typeof writtenNotes>>;
  part: 'lead' | 'gotchas';
  srcKey?: string;
}
const { notes, part, srcKey } = Astro.props;
const Gotchas = notes?.Gotchas;
if (part === 'gotchas' && Gotchas && !srcKey) throw new Error('Notes: gotchas without a source key');
---

{part === 'lead' && notes?.lead && (
  <aside class="leadbox">
    <p class="eyebrow">From families who've done this</p>
    <p class="lead">{notes.lead}</p>
  </aside>
)}
{part === 'gotchas' && Gotchas && (
  <FactBlock id="gotchas" title="Gotchas" summary="From families who've lived here" summarySrc={srcKey} srcs={[srcKey!]} asOf={`Written ${notes!.verifiedOn}`} source="families who've done this move">
    <div data-src={srcKey}><Gotchas /></div>
  </FactBlock>
)}
