---
// Fire (pending), flood and aircraft noise for these zips.
import { getCollection } from 'astro:content';
import FactBlock from '../FactBlock.astro';
import ExtLink from '../ExtLink.astro';
import { pct } from '../../lib/format';
import { provenance } from '../../lib/prov';
import { gapLine, missingZips, OUT_OF_PULL } from '../../lib/gaps';

interface Props { zips: string[] }
const { zips } = Astro.props;
const { asOf } = await provenance();
const hazards = (await getCollection('hazards')).map((r) => r.data).filter((r) => zips.includes(r.zip));
const multiZip = hazards.length > 1;
const gap = gapLine(missingZips(zips, hazards), 'flood or noise figures', OUT_OF_PULL);
const NOISE_LABEL: Record<string, string> = {
  none: 'Outside the MCAS Miramar 65 dB noise contour',
  '65-70': 'Inside the MCAS Miramar 65–70 dB noise contour',
  '70-75': 'Inside the MCAS Miramar 70–75 dB noise contour',
  '75plus': 'Inside the MCAS Miramar 75+ dB noise contour',
  manual: 'Near NAS North Island; noise zone not yet assigned',
};
---

<FactBlock id="hazards" title="Hazards" asOf={asOf('hazards')} source="FEMA National Flood Hazard Layer; MCAS Miramar noise contours (2008 airport land use plan, via SANDAG); CAL FIRE (pending)">
  {hazards.map((h) => (
    <dl class="facts">
      {multiZip && <><dt>Zip</dt><dd>{h.zip}</dd></>}
      <dt>Fire</dt>
      <dd>{h.fhsz_very_high_pct != null ? `${pct(h.fhsz_very_high_pct, 1)} of land in a Very High fire hazard zone` : <span>Not in our data yet. Check the address yourself: <ExtLink id="cal-fire-fhsz" /></span>}</dd>
      <dt>Flood</dt>
      <dd>{pct(h.sfha_pct, 1)} of land is in a FEMA 1%-annual-chance flood zone. <ExtLink id="fema-flood-map" text="Check an address" /></dd>
      <dt>Aircraft noise</dt>
      <dd>{NOISE_LABEL[h.aicuz_zone]}{h.miramar_cnel65plus_pct ? ` (${pct(h.miramar_cnel65plus_pct, 1)} of land at 65 dB or more)` : ''}.</dd>
    </dl>
  ))}
  {gap && <p class="gap">{gap}</p>}
  <p class="gap">Aircraft noise here covers MCAS Miramar only. Noise contours for San Diego International, the other Navy and Marine airfields and the county's smaller airports aren't in our data yet.</p>
</FactBlock>
