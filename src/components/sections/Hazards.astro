---
// Fire (CAL FIRE hazard severity zones), flood and aircraft noise for these zips.
import { getCollection, getEntry } from 'astro:content';
import FactBlock from '../FactBlock.astro';
import ExtLink from '../ExtLink.astro';
import { pct } from '../../lib/format';
import { provenance } from '../../lib/prov';
import { gapLine, missingZips, OUT_OF_PULL } from '../../lib/gaps';

// waterQuality: coastal pages get the county's beach and bay closures link.
interface Props { zips: string[]; waterQuality?: boolean }
const { zips, waterQuality = false } = Astro.props;
const { asOf } = await provenance();
const hazards = (await getCollection('hazards')).map((r) => r.data).filter((r) => zips.includes(r.zip));
const multiZip = hazards.length > 1;
const beachLink = (await getEntry('links', 'sd-county-beach-bay'))!.data;
const gap = gapLine(missingZips(zips, hazards), 'flood or noise figures', OUT_OF_PULL);
// Fire: share of land in each CAL FIRE class (exclusive; SRA 2023 + LRA 2025 combined by the pull).
const fireText = (h: (typeof hazards)[number]) => {
  const parts = [['Very High', h.fhsz_very_high_pct], ['High', h.fhsz_high_pct], ['Moderate', h.fhsz_moderate_pct]]
    .filter(([, v]) => (v as number) > 0).map(([k, v]) => `${pct(v as number, 1)} ${k}`);
  return parts.length ? `${parts.join(', ')} (share of land in each CAL FIRE fire hazard severity zone)` : 'No land in a CAL FIRE fire hazard severity zone';
};
// Noise contours we have in GIS: MCAS Miramar and NAS North Island (SDCRAA ALUCP, via SANDAG).
const FIELD_NAME: Record<string, string> = { Miramar: 'MCAS Miramar', 'North Island NAS': 'NAS North Island' };
const BAND: Record<string, string> = { '65-70': '65–70 dB', '70-75': '70–75 dB', '75+': '75+ dB' };
const fieldNames = (f: string | null) => (f ?? '').split(' + ').map((x) => FIELD_NAME[x] ?? x).join(' and ');
// Share of land at 65 dB or more, per field, wherever it isn't zero.
const shares = (h: (typeof hazards)[number]) => [
  ['MCAS Miramar', h.miramar_cnel65plus_pct], ['NAS North Island', h.nasni_cnel65plus_pct],
].filter(([, v]) => v).map(([n, v]) => `${pct(v as number, 1)} of land at 65 dB or more from ${n}`);
const zoneText = (h: (typeof hazards)[number]) =>
  h.aicuz_zone === 'none' ? `${shares(h).length ? 'Mostly outside' : 'Outside'} the MCAS Miramar and NAS North Island 65 dB noise contours`
  : h.aicuz_zone === 'manual' ? 'Noise zone not yet assigned'
  : `Inside the ${fieldNames(h.aicuz_field)} ${BAND[h.aicuz_zone]} noise contour${h.aicuz_field?.includes(' + ') ? 's' : ''}`;
// "within 3 km of NAS North Island and NOLF Imperial Beach; …" -> "NAS North Island and NOLF Imperial Beach"
const nearFields = (note: string | null) => note?.match(/within \d+ km of ([^;]+);/)?.[1] ?? null;
const noiseText = (h: (typeof hazards)[number]) =>
  // Near NOLF Imperial Beach (no contours) but inside North Island's: give the band we have, then the gap.
  h.aicuz_zone === 'manual' && h.aicuz_gis_zone !== 'none' && nearFields(h.aicuz_note)
    ? `Inside the ${fieldNames(h.aicuz_gis_field)} ${BAND[h.aicuz_gis_zone]} noise contour; ${nearFields(h.aicuz_note)} is also nearby, and its contours aren't in our data yet`
    : h.aicuz_zone === 'manual' && nearFields(h.aicuz_note)
    ? `Near ${nearFields(h.aicuz_note)}; noise zone not yet assigned (${nearFields(h.aicuz_note)!.includes(' and ') ? 'those fields’' : 'that field’s'} noise contours aren't in our data yet)`
    : zoneText(h);
const spanPct = (vals: (number | null)[]) => {
  const v = vals.filter((x): x is number => x != null);
  if (!v.length) return null;
  const lo = Math.min(...v), hi = Math.max(...v);
  return lo === hi ? pct(lo, lo < 10 && lo > 0 ? 1 : 0) : `${pct(lo, 0)}–${pct(hi, 0)}`;
};
const fireSpan = spanPct(hazards.map((h) => h.fhsz_very_high_pct));
const floodSpan = spanPct(hazards.map((h) => h.sfha_pct));
const noisy = hazards.some((h) => h.aicuz_zone !== 'none');
const summary = [
  fireSpan != null ? `Fire: ${fireSpan} Very High` : 'Fire: not in our data',
  floodSpan != null ? `flood zone ${floodSpan}` : null,
  noisy ? 'aircraft noise: see inside' : null,
].filter(Boolean).join(' · ');
---

<FactBlock id="hazards" title="Hazards" summary={summary} asOf={asOf('hazards')} source={`FEMA National Flood Hazard Layer; MCAS Miramar and NAS North Island noise contours (airport land use plans, via SANDAG); CAL FIRE Fire Hazard Severity Zones (State Responsibility Area 2023, Local Responsibility Area 2025)${waterQuality ? '; San Diego County Beach and Bay Program (link only)' : ''}`}>
  {hazards.map((h) => (
    <dl class="facts">
      {multiZip && <><dt>Zip</dt><dd>{h.zip}</dd></>}
      <dt>Fire</dt>
      <dd>{h.fhsz_very_high_pct != null ? <>{fireText(h)}. <span class="muted">CAL FIRE maps, downloaded {h.fhsz_retrieved_on}.</span> <ExtLink id="cal-fire-fhsz" text="Check an address" />{h.fhsz_mapped_pct != null && h.fhsz_mapped_pct < 95 && <span class="gap-inline"> CAL FIRE rates only {pct(h.fhsz_mapped_pct, 0)} of this zip's land. Federal land, such as bases and national forest, isn't in its maps, so the real share in a hazard zone can be higher.</span>}</> : <span>Not in our data yet. Check the address yourself: <ExtLink id="cal-fire-fhsz" /></span>}</dd>
      <dt>Flood</dt>
      <dd>{pct(h.sfha_pct, 1)} of land is in a FEMA 1%-annual-chance flood zone. <ExtLink id="fema-flood-map" text="Check an address" /></dd>
      <dt>Aircraft noise</dt>
      <dd>{noiseText(h)}{shares(h).length ? ` (${shares(h).join('; ')})` : ''}.</dd>
    </dl>
  ))}
  {waterQuality && (
    <dl class="facts">
      <dt>Beach and bay water</dt>
      <dd>Closures and advisories change daily, so we link to them rather than copy them: <ExtLink id="sd-county-beach-bay" /> <span class="muted">(link checked {beachLink.verified_on})</span></dd>
    </dl>
  )}
  {gap && <p class="gap">{gap}</p>}
  <p class="gap">Aircraft noise here covers MCAS Miramar and NAS North Island only. Noise contours for NOLF Imperial Beach, San Diego International, Camp Pendleton's airfield and the county's smaller airports aren't in our data yet.</p>
</FactBlock>
