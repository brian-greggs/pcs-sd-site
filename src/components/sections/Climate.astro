---
// July high, hot days and building climate zone, beside the Coronado coastal baseline.
import { getCollection, getEntry } from 'astro:content';
import FactBlock from '../FactBlock.astro';
import { provenance, titleCase } from '../../lib/prov';
import { gapLine, missingZips, OUT_OF_PULL } from '../../lib/gaps';

interface Props { zips: string[]; name: string }
const { zips, name } = Astro.props;
const { asOf } = await provenance();
const climate = (await getCollection('climate')).map((r) => r.data).filter((r) => zips.includes(r.zip));
const coastal = (await getEntry('climate', '92118'))!.data; // Coronado: the coastal baseline used in T12
const showCoastal = !zips.includes('92118');
const gap = gapLine(missingZips(zips, climate), 'climate normals', OUT_OF_PULL);
// station_flag (kept, not corrected), ';'-joined: elevation delta > 300 m, station > 10 km away.
// One caveat line names the reasons. An unknown flag fails the build.
const FLAG_TEXT: Record<string, string> = {
  'abs(elevation_delta_m)>300': 'more than 300 m higher or lower',
  'station_distance_km>10': 'more than 10 km away',
};
const flagged = climate.filter((c) => c.station_flag);
const reasons = (c: (typeof climate)[number]) => c.station_flag!.split(';').map((f) => {
  if (!FLAG_TEXT[f]) throw new Error(`Climate: unknown station_flag "${f}" for ${c.zip}`);
  return FLAG_TEXT[f];
});
const where = (c: (typeof climate)[number]) => (climate.length > 1 ? `zip ${c.zip}` : name);
const label = (zip: string) => (climate.length > 1 ? zip : name);
---

<FactBlock id="climate" title="Climate" asOf={asOf('climate')} source="NOAA U.S. Climate Normals 1991–2020 (nearest station); California Energy Commission building climate zones">
  {gap && <p class="gap">{gap}</p>}
  <div class="table-wrap">
    <table>
      <thead><tr><th></th>{climate.map((c) => <th class="num">{label(c.zip)}</th>)}{showCoastal && <th class="num">Coronado (coast)</th>}</tr></thead>
      <tbody>
        <tr><td>July average high</td>{climate.map((c) => <td class="num">{Math.round(c.july_mean_max_f)}°F</td>)}{showCoastal && <td class="num">{Math.round(coastal.july_mean_max_f)}°F</td>}</tr>
        <tr><td>Days at 90°F or hotter, per year</td>{climate.map((c) => <td class="num">{Math.round(c.days_ge_90f)}</td>)}{showCoastal && <td class="num">{Math.round(coastal.days_ge_90f)}</td>}</tr>
        <tr><td>State building climate zone</td>{climate.map((c) => <td class="num">{c.cec_climate_zone}</td>)}{showCoastal && <td class="num">{coastal.cec_climate_zone}</td>}</tr>
      </tbody>
    </table>
  </div>
  {flagged.map((c) => <p class="gap">The nearest weather station for {where(c)} is {reasons(c).join(', and ')}, so the real temperatures can differ from these.</p>)}
  {climate.length > 0 && <p class="note">Weather station: {climate.map((c) => `${titleCase(c.noaa_station_name)}, ${c.station_distance_km} km away`).join('; ')}.</p>}
  <p class="gap">Whether a home has air conditioning isn't published anywhere. On hot inland days it matters, so ask before you sign.</p>
</FactBlock>
