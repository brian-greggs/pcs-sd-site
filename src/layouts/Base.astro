---
// Every page uses this layout: noindex until week 5; no analytics, cookies or
// third-party requests. Fonts are self-hosted (@fontsource, bundled into dist/),
// so a reader's browser only ever talks to this site (Principle 3). The
// "unofficial" line is Principle 7.
import '@fontsource/bricolage-grotesque/latin-600.css';
import '@fontsource/bricolage-grotesque/latin-700.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-700.css';
import '../styles/site.css';
import MenuLinks from '../components/MenuLinks.astro';

interface Props {
  title: string;
  description?: string;
  // A natural parent page: the bar shows "‹ back" to it, beside the site name.
  back?: { href: string; label: string };
  // "Start over" under the site name: the page's screens (the plan's cards and result) leave what's on them when the
  // name takes the reader home. Home shows it itself once a conversation starts ([data-site-sub]).
  startOver?: boolean;
  // The footer's first line. Home uses its own ("Every answer cites…"); other pages keep the two general lines.
  footerNote?: string;
}
const { title, description = 'An unofficial, non-commercial guide for military families moving to San Diego.', back: backTo, startOver = false, footerNote } = Astro.props;
// The site name goes home on every page, so a "back" to home would repeat it.
const back = backTo && backTo.href !== '/' ? backTo : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B1328" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · San Diego PCS Guide (beta)</title>
    <slot name="head" />
    <script is:inline>
      // Before first paint, so the drawer and the wide-screen sidebar don't jump: "js" turns the menu on (without it
      // the menu button is a plain link to /browse/), and a sidebar collapsed earlier in this tab stays collapsed.
      document.documentElement.classList.add('js');
      try { if (sessionStorage.getItem('pcs-sd:sidebar') === 'collapsed') document.documentElement.classList.add('sidebar-collapsed'); } catch { /* storage blocked */ }
    </script>
  </head>
  <body>
    <div class="stripe" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <a class="skip" href="#main">Skip to content</a>
    <header class="bar">
      <div class="bar-start">
        <a class="menu-btn" href="/browse/" data-menu-btn aria-controls="site-menu"><span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span><span class="menu-word">Menu</span></a>
        <a class="site-name" href="/" data-site-name><span class="site-title">San Diego PCS Guide</span><span class="site-sub" data-site-sub hidden={!startOver}>Start over</span></a>
      </div>
      <div class="bar-end">
        {back && <a class="back" href={back.href} aria-label={`Back to ${back.label}`} data-back>‹ back</a>}
        <span class="beta">BETA</span>
      </div>
    </header>
    <div class="drawer" id="site-menu" data-drawer>
      <div class="drawer-scrim" data-menu-scrim></div>
      <nav class="drawer-panel" aria-label="Site menu" data-menu-panel>
        <div class="drawer-head">
          <p class="drawer-title">Menu</p>
          <button type="button" class="drawer-close" data-menu-close aria-label="Close menu"><span aria-hidden="true">×</span></button>
        </div>
        <MenuLinks />
      </nav>
    </div>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      {footerNote
        ? <p data-footer-note>{footerNote}</p>
        : <><p>Every fact carries the date it was checked.</p><p>No ads, no referrals, nothing you type is collected.</p></>}
      <p class="muted">Unofficial and non-commercial. Not affiliated with the Navy, the Marine Corps or DoD.</p>
      <nav>
        <a href="/sources/">Sources</a>
        <a href="/changelog/">What changed</a>
      </nav>
    </footer>
    <script>
      // Every <details> starts closed (Brian 2026-10-23). A link to a section, a form row or a heading inside one
      // (#id) opens it and any closed <details> around it. Without JavaScript the link still scrolls there.
      const openTarget = () => {
        const el = location.hash.length > 1 ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
        if (!el) return;
        const own = el.querySelector(':scope > details');
        if (own instanceof HTMLDetailsElement) own.open = true;
        for (let d = el.closest('details'); d; d = d.parentElement?.closest('details') ?? null) d.open = true;
      };
      openTarget();
      addEventListener('hashchange', openTarget);
    </script>
    <script>
      // The menu. Under 1024 px it's a drawer over the page: the rest of the page is inert while it's open, Tab stays
      // inside it, Escape or the close button closes it and focus goes back to the menu button. From 1024 px it's a
      // sidebar on the left that the same button collapses (remembered for this tab only). Without JavaScript the
      // button is a link to /browse/, which lists the same links (src/lib/menu.ts).
      const root = document.documentElement;
      const btn = document.querySelector<HTMLAnchorElement>('[data-menu-btn]')!;
      const drawer = document.querySelector<HTMLElement>('[data-drawer]')!;
      const panel = document.querySelector<HTMLElement>('[data-menu-panel]')!;
      const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]')!;
      const wide = matchMedia('(min-width: 1024px)');
      const outside = () => [...document.body.children].filter((e) => e !== drawer && e.tagName !== 'SCRIPT') as HTMLElement[];
      const focusables = () => [...panel.querySelectorAll<HTMLElement>('a[href], button')].filter((e) => e.offsetParent !== null);
      btn.setAttribute('role', 'button');
      const sync = () => {
        const open = wide.matches ? !root.classList.contains('sidebar-collapsed') : root.classList.contains('menu-open');
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', wide.matches ? (open ? 'Hide menu' : 'Show menu') : 'Menu');
        if (wide.matches) { panel.removeAttribute('role'); panel.removeAttribute('aria-modal'); }
        else { panel.setAttribute('role', 'dialog'); panel.setAttribute('aria-modal', 'true'); }
        closeBtn.setAttribute('aria-label', wide.matches ? 'Hide menu' : 'Close menu');
        const trap = !wide.matches && open;
        for (const e of outside()) e.inert = trap;
      };
      const remember = (collapsed: boolean) => {
        try { collapsed ? sessionStorage.setItem('pcs-sd:sidebar', 'collapsed') : sessionStorage.removeItem('pcs-sd:sidebar'); } catch { /* storage blocked */ }
      };
      const openMenu = () => {
        if (wide.matches) { root.classList.remove('sidebar-collapsed'); remember(false); sync(); return; }
        root.classList.add('menu-open');
        sync();
        closeBtn.focus();
      };
      const closeMenu = () => {
        if (wide.matches) { root.classList.add('sidebar-collapsed'); remember(true); }
        else root.classList.remove('menu-open');
        sync();
        btn.focus();
      };
      const isOpen = () => (wide.matches ? !root.classList.contains('sidebar-collapsed') : root.classList.contains('menu-open'));
      btn.addEventListener('click', (e) => { e.preventDefault(); isOpen() ? closeMenu() : openMenu(); });
      btn.addEventListener('keydown', (e) => { if (e.key === ' ') { e.preventDefault(); btn.click(); } });
      closeBtn.addEventListener('click', closeMenu);
      document.querySelector('[data-menu-scrim]')!.addEventListener('click', closeMenu);
      drawer.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen()) { e.preventDefault(); closeMenu(); return; }
        if (e.key !== 'Tab' || wide.matches) return;
        const f = focusables();
        if (!f.length) return;
        if (e.shiftKey && document.activeElement === f[0]) { e.preventDefault(); f.at(-1)!.focus(); }
        else if (!e.shiftKey && document.activeElement === f.at(-1)) { e.preventDefault(); f[0].focus(); }
      });
      // A link to a section of the page you're on closes the drawer, so the section isn't left under it.
      panel.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a') && !wide.matches) { root.classList.remove('menu-open'); sync(); }
      });
      wide.addEventListener('change', () => { root.classList.remove('menu-open'); sync(); });
      sync();
    </script>
  </body>
</html>
