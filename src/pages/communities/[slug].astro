---
// Neighborhood page (F1). Facts side by side, no scores. Every section is a
// FactBlock with its date line. Built for every community in the exported data;
// the lead and gotchas in src/content/communities/<slug>.md render only once
// written, and a community with no file simply has none. Base housing has its
// own pages (/base-housing/<area>/) and isn't on this one.
//
// "At a glance" and the pay-band picker: every variant (each base, each pay
// band, and for BAH and the rent-to-BAH ratio each duty-station MHA) is rendered
// into the page and src/scripts/variants.ts only toggles which one shows, so the
// principle checks see every word, and with JavaScript off or storage blocked the
// page shows the nearest base and E5–E6. Nothing leaves the device.
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FactBlock from '../../components/FactBlock.astro';
import ExtLink from '../../components/ExtLink.astro';
import Commute from '../../components/sections/Commute.astro';
import Schools from '../../components/sections/Schools.astro';
import Childcare from '../../components/sections/Childcare.astro';
import Access from '../../components/sections/Access.astro';
import Climate from '../../components/sections/Climate.astro';
import Hazards from '../../components/sections/Hazards.astro';
import Notes from '../../components/sections/Notes.astro';
import Toc from '../../components/Toc.astro';
import SourcesTable from '../../components/sections/SourcesTable.astro';
import BahLines from '../../components/BahLines.astro';
import SiteMap from '../../components/SiteMap.astro';
import SourceChip from '../../components/SourceChip.astro';
import MethodHint from '../../components/MethodHint.astro';
import { acsDollars, dollars, pct, range, PAY_BAND_ORDER } from '../../lib/format';
import { provenance } from '../../lib/prov';
import { writtenNotes } from '../../lib/notes';
import { gapLine, missingZips, OUT_OF_PULL } from '../../lib/gaps';
import { baseByCode, drives, minutes } from '../../lib/bases';
import { bahTable } from '../../lib/bah';

export async function getStaticPaths() {
  return (await getCollection('communities')).map((c) => ({ params: { slug: c.id } }));
}

const { slug } = Astro.params;
const community = (await getEntry('communities', slug!))!.data;
// Most communities have no notes file yet; find() avoids a not-found warning per page.
const notes = await writtenNotes((await getCollection('communityNotes')).find((n) => n.id === slug));
const zips = community.zips;
const inZips = (r: { data: { zip: string } }) => zips.includes(r.data.zip);
const multiZip = zips.length > 1;
const { asOf } = await provenance();

// --- Cost ---------------------------------------------------------------
const rent = (await getCollection('rent')).filter(inZips).map((r) => r.data);
const ratios = (await getCollection('rentToBah')).filter(inZips).map((r) => r.data);
const bands = PAY_BAND_ORDER.filter((b) => ratios.some((r) => r.pay_band === b));
// The ratio divides by the BAH of the reader's duty station (one row per MHA; Brian 2026-10-20, QUESTIONS 62).
const ratioCell = (zip: string, band: string, br: number, mha: string) => {
  const r = ratios.find((x) => x.zip === zip && x.pay_band === band && x.bedrooms === br && x.mha === mha);
  return r ? range(r.ratio_low_pct, r.ratio_high_pct, '%') : '—';
};
const ownership = (await getCollection('ownership')).filter((r) => r.data.community_slug === slug).map((r) => r.data);
// No CFD is named on the site until T4b verifies it per parcel.
const CFD_LABEL: Record<string, string> = {
  N: 'No active Mello-Roos district on the county list.',
  Y: 'Mello-Roos (CFD) charge on the tax bill.',
  mixed: 'Some tracts carry a Mello-Roos charge, some don’t. Check the parcel before an offer.',
  unknown: 'Parts of this area may sit in a Mello-Roos district. Check the parcel before an offer.',
};
const parcelLinkInline = ownership.some((o) => o.has_cfd === 'unknown' || o.has_cfd === 'mixed');
const rentGap = gapLine(missingZips(zips, rent), 'HUD reference rent', OUT_OF_PULL);
const ratioGap = gapLine(missingZips(zips, ratios), 'rent-to-allowance ratio', 'there’s no HUD reference rent to divide');
// Coastal South Bay and Coronado: on the ocean or San Diego Bay, where beach and bay closures are common.
// Otay Mesa / San Ysidro is left off on purpose (inland of the Tijuana River valley beaches; Brian 2026-09-30).
const WATER_QUALITY = ['coronado', 'imperial-beach', 'chula-vista-west', 'national-city'];
// --- At a glance -----------------------------------------------------------
const DEFAULT_BAND = 'E5–E6';
const ds = await drives(zips);
const spanOf = (lo: number[], hi: number[], unit: string) =>
  lo.length ? range(Math.min(...lo), Math.max(...hi), unit) : '—';
const ratio3 = (band: string, mha: string) => {
  const rs = ratios.filter((r) => r.pay_band === band && r.bedrooms === 3 && r.mha === mha);
  return spanOf(rs.map((r) => r.ratio_low_pct), rs.map((r) => r.ratio_high_pct), '%');
};
const schoolRows = (await getCollection('schools')).filter(inZips).map((r) => r.data);
const districtNames = [...new Set(schoolRows.filter((s) => s.charter === 'N').map((s) => s.district))];
const hazards = (await getCollection('hazards')).filter(inZips).map((r) => r.data);
const veryHigh = hazards.map((h) => h.fhsz_very_high_pct).filter((x): x is number => x != null);
const fireValue = veryHigh.length
  ? (Math.min(...veryHigh) === Math.max(...veryHigh) ? pct(veryHigh[0], veryHigh[0] > 0 && veryHigh[0] < 10 ? 1 : 0) : `${pct(Math.min(...veryHigh), 0)}–${pct(Math.max(...veryHigh), 0)}`)
  : null;
const mapped = hazards.map((h) => h.fhsz_mapped_pct).filter((x): x is number => x != null);
const leastMapped = mapped.length ? Math.min(...mapped) : null;
const fireDate = hazards.map((h) => h.fhsz_retrieved_on).find(Boolean);
const fireKeys = hazards.filter((h) => h.fhsz_very_high_pct != null).map((h) => `fhsz:${h.zip}`);
const rent3 = rent.map((r) => r.fy27_3br).filter((x): x is number => x != null);
const rent3Text = rent3.length ? (Math.min(...rent3) === Math.max(...rent3) ? dollars(rent3[0]) : `${dollars(Math.min(...rent3))}–${dollars(Math.max(...rent3))}`) : '—';
const cfd = new Set(ownership.map((o) => o.has_cfd));
const melloLine = !ownership.length ? 'Mello-Roos not matched yet'
  : cfd.has('unknown') || cfd.has('mixed') ? 'Mello-Roos: check the parcel'
  : cfd.has('Y') ? 'Mello-Roos charge on the tax bill'
  : 'no Mello-Roos district listed';
const costSummary = `3-bed HUD rent ${rent3Text} · ${melloLine}`;
// BAH (Brian 2026-10-20): the figures for the reader's base (?base=, else the nearest) and pay band, next to
// the rent. The ratio below divides by the zip's own MHA, which can be the other one; the note says so.
const bah = await bahTable();
const defaultBase = ds[0] ? baseByCode(ds[0].code).slug : null;
const bahDefault = ds[0] ? bah.areaOf(ds[0].code).mha : bah.areas[0].mha;

const sections = [
  { id: 'glance', label: 'At a glance' }, { id: 'cost', label: 'Cost' }, { id: 'commute', label: 'Commute' },
  { id: 'schools', label: 'Schools' }, { id: 'childcare', label: 'Child care' }, { id: 'access', label: 'Commissary & Costco' },
  { id: 'climate', label: 'Climate' }, { id: 'hazards', label: 'Hazards' },
  ...(notes?.Gotchas ? [{ id: 'gotchas', label: 'Gotchas' }] : []), { id: 'sources', label: 'Sources' },
];
---

<Base title={community.name} back={{ href: '/neighborhoods/', label: 'Neighborhoods' }} description={`${community.name}: cost, commute, schools, child care and hazards, side by side with dates.`}>
  <div class="page-grid">
  <Toc items={sections} />
  <div class="page-main" data-default-base={defaultBase}>
  <h1>{community.name}</h1>
  <p class="kicker">{community.corridor} · {zips.join(', ')}</p>
  <SiteMap kind="locator" community={slug} />

  <Notes notes={notes} part="lead" />

  <section class="glance" id="glance" data-fact="glance">
    <div class="glance-head">
      <h2>At a glance</h2>
      <label class="band-pick" data-band-picker data-nofact hidden>Pay band
        <select data-band-select>
          {bands.map((b) => <option value={b} selected={b === DEFAULT_BAND}>{b}</option>)}
        </select>
      </label>
    </div>
    <dl class="tiles">
      <div class="tile blue" data-src="prov:commute">
        <dt>Commute at 0700</dt>
        {ds.map((d, i) => (
          <dd data-base={baseByCode(d.code).slug} hidden={i !== 0}>
            <span class="tile-value">{minutes(d)}</span>
            <span class="tile-sub">to {baseByCode(d.code).short}{i === 0 ? ' (nearest)' : ''}</span>
          </dd>
        ))}
        {ds.length === 0 && <dd><span class="tile-value">—</span><span class="tile-sub">No drive times in our data</span></dd>}
      </div>
      <div class="tile mauve" data-src="prov:rent_to_bah">
        <dt>3-bed rent vs. BAH</dt>
        {bah.areas.map((a) => bands.map((b) => (
          <dd data-band-show={b} data-mha-bases={a.bases.join(' ')} hidden={b !== DEFAULT_BAND || a.mha !== bahDefault}>
            <span class="tile-value">{ratio3(b, a.mha)}</span>
            <span class="tile-sub">HUD rent, {b}, {a.area} area BAH</span>
          </dd>
        )))}
        {bands.length === 0 && <dd><span class="tile-value">—</span><span class="tile-sub">No HUD rent for this zip</span></dd>}
      </div>
      <div class="tile blue" data-src="prov:schools">
        <dt>School district</dt>
        <dd>
          <span class="tile-value tile-text">{districtNames[0] ?? '—'}{districtNames.length > 1 && <span class="muted"> +{districtNames.length - 1}</span>}</span>
          <span class="tile-sub">{schoolRows.length} public {schoolRows.length === 1 ? 'school' : 'schools'} in {multiZip ? 'these zips' : 'the zip'}</span>
        </dd>
      </div>
      <div class="tile gold" data-src={fireValue ? fireKeys.join(' ') : 'prov:hazards'}>
        <dt>Fire</dt>
        <dd>
          <span class="tile-value">{fireValue ?? '—'}</span>
          <span class="tile-sub">{fireValue ? 'of land rated Very High by CAL FIRE' : 'Not in our data yet'}</span>
          {leastMapped != null && leastMapped < 95 && <span class="tile-sub">CAL FIRE rates only {pct(leastMapped, 0)} of {multiZip ? 'the land in one zip here' : 'this zip’s land'}; federal land isn’t mapped.</span>}
        </dd>
      </div>
    </dl>
    <SourceChip srcs={['prov:commute', 'prov:rent_to_bah', 'prov:schools', ...(fireValue ? fireKeys : ['prov:hazards'])]} asOf={`Commute: ${asOf('commute')}. Rent ratio: ${asOf('rent_to_bah')}. Schools: ${asOf('schools')}. Fire: ${fireDate ? `CAL FIRE maps, downloaded ${fireDate}` : asOf('hazards')}`} source="Google Maps predicted drive times; HUD Small Area Fair Market Rents and DTMO BAH; California Department of Education; CAL FIRE Fire Hazard Severity Zones" />
  </section>

  <FactBlock id="cost" title="Cost" summary={costSummary} summarySrc="prov:rent prov:ownership" srcs={['prov:rent', 'prov:bah', 'prov:rent_to_bah', 'prov:ownership', 'link:per-parcel-lookup']} asOf={`Rent: ${asOf('rent')}. BAH: ${asOf('bah')}. Ratio: ${asOf('rent_to_bah')}. Mello-Roos: ${asOf('ownership')}`} source={`HUD Small Area Fair Market Rents FY2027; US Census ACS 5-year 2020–2024; ${bah.areas[0].source_name}; SD County Auditor & Controller, Active Mello-Roos Districts FY2025-26`}>
    {/* Your pay band first (Brian 2026-10-23): the BAH lines, the ratio row and the 3-bed rent for the band picked
        at the top and your base's housing area; every band is behind "Show all pay bands". data-unranked: the BAH
        lines are sent to the assistant with this section but left out of its ranking, so 40 copies of the same
        lines don't outrank the base pages' tables. */}
    <div class="bah" data-unranked data-src="prov:bah">
      <BahLines areas={bah.areas} bands={bands.length ? bands : PAY_BAND_ORDER} mha={bahDefault} band={DEFAULT_BAND} />
    </div>
    {rentGap && <p class="gap" data-src="prov:rent">{rentGap}</p>}
    {ratioGap && <p class="gap" data-src="prov:rent_to_bah">{ratioGap}</p>}
    {/* data-dup: the same figures are in the full tables below, which the assistant corpus keeps. */}
    <div class="mine" data-dup>
      {rent3.length > 0 && <p data-src="prov:rent">3-bed HUD reference rent: {multiZip ? rent.filter((r) => r.fy27_3br != null).map((r) => `${dollars(r.fy27_3br)} (${r.zip})`).join(' · ') : dollars(rent3[0])} a month.</p>}
      {bah.areas.map((a) => bands.map((b) => (
        <div class="table-wrap" data-src="prov:rent_to_bah" data-band-show={b} data-mha-bases={a.bases.join(' ')} hidden={b !== DEFAULT_BAND || a.mha !== bahDefault}>
          <table>
            <caption>Rent as a share of allowance, {b} · {a.area} area (MHA {a.mha})</caption>
            <thead><tr><th>{multiZip ? 'Zip' : 'Bedrooms'}</th><th class="num">2 bed</th><th class="num">3 bed</th><th class="num">4 bed</th></tr></thead>
            <tbody>
              {rent.filter((r) => ratios.some((x) => x.zip === r.zip && x.mha === a.mha)).map((r) => (
                <tr data-ratio-mine={`${r.zip}|${b}|${a.mha}`}><td>{multiZip ? r.zip : b}</td>{[2, 3, 4].map((br) => <td class="num">{ratioCell(r.zip, b, br, a.mha)}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      )))}
    </div>
    <MethodHint topic="ratio" text="The share is HUD rent divided by your base’s BAH." />

    <details class="more">
      <summary data-ui>Show all pay bands</summary>
      <h3>Rent</h3>
      {rent.map((r) => (
        <div data-src="prov:rent">
          <div class="table-wrap">
            <table>
              <caption>HUD reference rent{multiZip ? `, zip ${r.zip}` : ''}: 40th-percentile rent including utilities{r.safmr_metro_default ? ' (metro default, not zip-specific)' : ''}</caption>
              <thead><tr><th>Bedrooms</th><th class="num">Studio</th><th class="num">1</th><th class="num">2</th><th class="num">3</th><th class="num">4</th></tr></thead>
              <tbody><tr><td>Monthly</td><td class="num">{dollars(r.fy27_0br)}</td><td class="num">{dollars(r.fy27_1br)}</td><td class="num">{dollars(r.fy27_2br)}</td><td class="num">{dollars(r.fy27_3br)}</td><td class="num">{dollars(r.fy27_4br)}</td></tr></tbody>
            </table>
          </div>
          <p class="note">Census median rent across all rented homes here: {acsDollars(r.acs_median_gross_rent)}. For what landlords are asking this month: <ExtLink href={r.zillow_url} incentive="Commercial: earns from agent referrals and listing ads" text="Zillow rent trends for this zip" src="prov:rent" />.</p>
        </div>
      ))}

      <h3>Rent as a share of your housing allowance</h3>
      {bah.areas.map((a) => (
        <div class="ratio-area" data-mha-bases={a.bases.join(' ')} hidden={a.mha !== bahDefault} data-src="prov:rent_to_bah">
          {rent.filter((r) => ratios.some((x) => x.zip === r.zip && x.mha === a.mha)).map((r) => (
            <div class="table-wrap">
              <table>
                <caption>{multiZip ? `Zip ${r.zip} · ` : ''}{a.area} area (MHA {a.mha})</caption>
                <thead><tr><th>Pay band</th><th class="num">2 bed</th><th class="num">3 bed</th><th class="num">4 bed</th></tr></thead>
                <tbody>
                  {bands.map((band) => (
                    <tr data-band-row={band} class={band === DEFAULT_BAND ? 'picked' : undefined}><td>{band}</td>{[2, 3, 4].map((br) => <td class="num">{ratioCell(r.zip, band, br, a.mha)}</td>)}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
        </div>
      ))}
      <p class="note" data-src="prov:rent_to_bah">A band shows a range when its grades get different allowances.</p>
    </details>

    <h3>Buying</h3>
    <dl class="facts" data-src="prov:rent prov:ownership">
      {rent.map((r) => (<>
        <dt>Census median home value{multiZip ? ` (${r.zip})` : ''}</dt>
        <dd>{acsDollars(r.acs_median_home_value)}.</dd>
      </>))}
      {ownership.map((o) => (<>
        <dt>Mello-Roos: {o.subarea || community.name}</dt>
        <dd>{CFD_LABEL[o.has_cfd]}{(o.has_cfd === 'unknown' || o.has_cfd === 'mixed') && <> <ExtLink id="per-parcel-lookup" /></>}</dd>
      </>))}
    </dl>
    {ownership.length === 0 && <p class="gap" data-src="prov:ownership">No Mello-Roos record for {community.name} yet: the county list hasn’t been matched to this area. Check the parcel before an offer.</p>}
    <p class="note" data-src="prov:ownership link:per-parcel-lookup">Mello-Roos is a fixed yearly charge on the property tax bill that doesn't drop when the home's value does. The only reliable check is the parcel itself{parcelLinkInline ? ', with the county lookup above.' : <>: <ExtLink id="per-parcel-lookup" /></>}</p>
    <MethodHint topic="hud-rent" text="Census medians are five-year estimates and lag the market." />
  </FactBlock>

  <Commute zips={zips} switchable />
  <Schools zips={zips} />
  <Childcare zips={zips} />
  <Access zips={zips} />
  <Climate zips={zips} name={community.name} />
  <Hazards zips={zips} waterQuality={WATER_QUALITY.includes(slug!)} />
  <Notes notes={notes} part="gotchas" srcKey={`notes:communities/${slug}`} />
  <SourcesTable ids={['rent', 'bah', 'rent_to_bah', 'ownership', 'commute', 'schools', 'childcare', 'military_access', 'climate', 'hazards']} />
  </div>
  </div>
</Base>

<script>
  // Pay band and base (?base=<slug> from a base page): src/scripts/variants.ts. The base also sets the back link.
  import { initVariants } from '../../scripts/variants';
  const { base } = initVariants();
  if (base) {
    const back = document.querySelector<HTMLAnchorElement>('[data-back]');
    if (back) { back.href = `/base/${base}/`; back.setAttribute('aria-label', 'Back to your base'); }
  }
</script>
