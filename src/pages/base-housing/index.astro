---
// Base housing index: every area, grouped by the base LMH names, with the
// latest wait range. Each area has its own page.
import Base from '../../layouts/Base.astro';
import FactBlock from '../../components/FactBlock.astro';
import ExtLink from '../../components/ExtLink.astro';
import { baseHousingAreas, INDEX_GROUPS } from '../../lib/baseHousing';
import BedroomRules from '../../components/sections/BedroomRules.astro';

const { areas, month, pdfs, verifiedOn } = await baseHousingAreas();
const listName = (g: string) => (g === 'officer' ? 'Officer' : 'Enlisted');
const waitLabel = (a: (typeof areas)[number]) =>
  a.waitRange ? `${a.waitRange[0] === a.waitRange[1] ? a.waitRange[0] : `${a.waitRange[0]}–${a.waitRange[1]}`} months`
  : a.base_group === 'PENDLETON' ? 'Not in our data' : 'Not on the list';
const unplaced = areas.filter((a) => !a.has_page);
---

<Base title="Base housing" back={{ href: '/', label: 'Home' }} description="Every base-housing community in San Diego, grouped into areas, with the latest wait range for each.">
  <h1>Base housing</h1>
  <p class="intro">
    Family housing on and near the San Diego bases is run by Liberty Military Housing (LMH) under the Navy and Marine
    Corps' public-private venture program. The communities are grouped into areas below; each area page has its
    communities, wait times, pet policy, how to apply, and the commute, schools and hazards around it.
  </p>
  <p class="gap">
    Wait ranges are the Navy Housing Service Center's estimate for {month}, across every list, pay grade and bedroom
    count in the area. They change every month; check the area page for your grade.
  </p>
  <ul class="links">
    {pdfs.map((p) => <li><ExtLink href={p.source_url} incentive={p.incentive} text={`${month} ${listName(p.rank_group)} wait-time list (PDF)`} /></li>)}
  </ul>

  <BedroomRules plain />

  <div class="index-grid">
  {INDEX_GROUPS.map((g) => {
    const rows = areas.filter((a) => a.has_page && a.base_group === g.key);
    return rows.length > 0 && (
      <FactBlock plain id={`areas-${g.key.toLowerCase()}`} title={g.title} asOf={`CNRSW estimate, ${month} · verified ${verifiedOn}`} source="Navy Housing Service Center / LMH wait-time lists; LMH community pages">
        <div class="table-wrap">
          <table>
            <thead><tr><th>Area</th><th>Communities</th><th>Wait, {month}</th></tr></thead>
            <tbody>
              {rows.map((a) => (
                <tr>
                  <td><a href={`/base-housing/${a.id}/`}>{a.name}</a>{a.base_tie_note && <><br /><span class="muted">{a.base_tie_note}</span></>}</td>
                  <td>{a.members.map((m) => m.community).join(', ')}</td>
                  <td>{waitLabel(a)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </FactBlock>
    );
  })}

  </div>

  {unplaced.map((a) => (
    <FactBlock plain id="location-pending" title={a.name} asOf={`CNRSW estimate, ${month} · verified ${verifiedOn}`} source="Navy Housing Service Center / LMH wait-time lists">
      <p class="note">{a.members.map((m) => m.community).join(' and ')} are on the {month} wait list ({waitLabel(a)}), but LMH gives no address for them yet, so they don't have a page.</p>
    </FactBlock>
  ))}
</Base>
