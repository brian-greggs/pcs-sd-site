---
// The move sequence (F2): the five phases, from orders to the first 30 days, and the forms page.
// Plan My Move is where a family builds its own checklist; this is the order the official rules imply.
import Base from '../../layouts/Base.astro';
import ExtLink from '../../components/ExtLink.astro';
import FactBlock from '../../components/FactBlock.astro';
import Cites from '../../components/sequence/Cites.astro';
import SequenceTop from '../../components/sequence/SequenceTop.astro';
import { PHASES, citeDates, citeNames } from '../../lib/sequence.js';
import { sequenceData } from '../../lib/sequenceData';

const { steps, forms, effective } = await sequenceData();
const count = (key: string) => steps.filter((s) => s.phase === key).length;
---

<Base title="Move sequence" back={{ href: '/', label: 'Home' }} description="A Navy PCS to San Diego in order, from orders to the first 30 days, with deadlines and official sources.">
  <p class="eyebrow">Orders to the first 30 days</p>
  <h1>The move sequence</h1>
  <SequenceTop />
  <p class="intro">Each step shows when it's due, what has to come first, the forms it involves and the official pages behind it, quoted.</p>

  <ul class="cards">
    {PHASES.map((p, i) => (
      <li>
        <a class="card" href={`/sequence/${p.slug}/`}>
          <span><span class="card-name">{i + 1}. {p.label}</span><span class="card-sub">{p.blurb} · {count(p.key)} steps</span></span>
          <span class="arrow" aria-hidden="true">›</span>
        </a>
      </li>
    ))}
    <li>
      <a class="card" href="/sequence/forms/">
        <span><span class="card-name">Forms and claims</span><span class="card-sub">{forms.length} forms and claims: deadline, where to file, what to attach</span></span>
        <span class="arrow" aria-hidden="true">›</span>
      </a>
    </li>
  </ul>

  <FactBlock plain id="effective-date" title={effective.title} asOf={citeDates(effective)} source={citeNames(effective)}>
    <p data-effective-line>{effective.line}</p>
    <Cites sources={effective.sources} />
  </FactBlock>

  <p class="note">To turn this into your own list, <ExtLink id="mos-plan-my-move" text="build your personal checklist" /> with Military OneSource's Plan My Move.</p>
</Base>
