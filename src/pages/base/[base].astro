---
// Base page: neighborhoods and base housing sorted by the 0700 drive to this
// base's main gate. Same layout as a neighborhood page: a sticky side menu at
// 1100px and up, and below that every group is a closed <details> with a summary
// line, so a phone reader sees Off base and Base housing on one screen.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FactBlock from '../../components/FactBlock.astro';
import Toc from '../../components/Toc.astro';
import { BASES, baseBySlug, drives, GROUP_BASES, minutes, TIERS } from '../../lib/bases';
import { baseHousingAreas } from '../../lib/baseHousing';
import { range } from '../../lib/format';
import { provenance } from '../../lib/prov';

export function getStaticPaths() {
  return BASES.map((b) => ({ params: { base: b.slug } }));
}

const base = baseBySlug(Astro.params.base!)!;
const { asOf } = await provenance();
const gate = (await getCollection('bases')).find((b) => b.id === base.code)!.data.gate;

// Off base: each neighborhood's drive to this base (range across its zips), grouped by tier.
const communities = (await getCollection('communities')).map((c) => c.data);
const rows = (await Promise.all(communities.map(async (c) => {
  const d = (await drives(c.zips)).find((x) => x.code === base.code);
  return d ? { ...c, drive: d } : null;
}))).filter((r) => !!r).sort((a, b) => a.drive.lo - b.drive.lo || a.drive.hi - b.drive.hi || a.name.localeCompare(b.name));
const missing = communities.length - rows.length;

// Base housing: areas LMH ties to this base, then the ones it ties to no base, by drive.
const { areas, month, verifiedOn } = await baseHousingAreas();
const estimate = `CNRSW estimate, ${month}`;
const withDrive = await Promise.all(areas.filter((a) => a.has_page).map(async (a) => ({
  ...a, drive: (await drives(a.facts_zips)).find((x) => x.code === base.code) ?? null,
})));
const byDrive = (a: (typeof withDrive)[number], b: (typeof withDrive)[number]) => (a.drive?.lo ?? 999) - (b.drive?.lo ?? 999);
const tied = withDrive.filter((a) => GROUP_BASES[a.base_group].includes(base.code)).sort(byDrive);
const untied = withDrive.filter((a) => a.base_group === 'NONE').sort(byDrive);
const span = (lo: number[], hi: number[], unit: string) => (lo.length ? range(Math.min(...lo), Math.max(...hi), unit) : '—');
const tiers = TIERS.map((t) => ({ ...t, id: `tier-${t.key}`, rows: rows.filter((r) => r.drive.tier === t.key) })).filter((t) => t.rows.length);
const tierSummary = (rs: typeof rows) =>
  // The tier comes from each neighborhood's closest zip, so the summary gives those minutes (rows show the full range).
  `${rs.length} ${rs.length === 1 ? 'neighborhood' : 'neighborhoods'} · ${span(rs.map((r) => r.drive.lo), rs.map((r) => r.drive.lo), ' min')}${rs.some((r) => r.drive.hi !== r.drive.lo) ? ' from the closest zip' : ''}`;
const waits = (as: typeof tied) => as.filter((a) => a.waitRange);
const housingSummary = (as: typeof tied, what: 'wait' | 'drive') => {
  if (!as.length) return 'None';
  const n = `${as.length} ${as.length === 1 ? 'area' : 'areas'}`;
  if (what === 'drive') return `${n} · ${span(as.flatMap((a) => (a.drive ? [a.drive.lo] : [])), as.flatMap((a) => (a.drive ? [a.drive.hi] : [])), ' min')} drive`;
  const w = waits(as);
  return w.length ? `${n} · wait ${span(w.map((a) => a.waitRange![0]), w.map((a) => a.waitRange![1]), '')} months` : `${n} · wait times not in our data`;
};
const commuteAsOf = asOf('commute');
const commuteSource = "Google Maps predicted drive time, Tuesday 0700, from the zip's center (rounded); a neighborhood with several zips shows the range";
const housingAsOf = `Waits: ${estimate} · verified ${verifiedOn}. Drive: ${asOf('commute')}`;
const housingSource = "Navy Housing Service Center / LMH wait-time lists; Google Maps predicted drive time from the area's zip";
const sections = [
  { id: 'off-base', label: 'Off base', children: tiers.map((t) => ({ id: t.id, label: t.label })) },
  { id: 'base-housing', label: 'Base housing', children: [{ id: 'housing-tied', label: 'Tied to this base' }, { id: 'housing-untied', label: 'Not tied to a base' }] },
];
const word = (n: number) => `${n} ${n === 1 ? 'community' : 'communities'}`;
---

<Base title={base.short} back={{ href: '/', label: 'Home' }} description={`Reporting to ${base.short}: neighborhoods and base housing sorted by the 0700 drive.`}>
  <div class="page-grid">
  <Toc items={sections} />
  <div class="page-main">
  <p class="eyebrow">Reporting to</p>
  <h1>{base.short}</h1>
  <p class="kicker">{gate}</p>
  <p class="note">Weekday drive to the main gate at 0700, from the middle of each neighborhood. Your street can add 5–10 minutes.</p>

  <h2 class="group-title" id="off-base">Off base</h2>
  {tiers.map((t) => (
    <FactBlock id={t.id} title={t.label} chip={t.tone} level={3} summary={tierSummary(t.rows)} asOf={commuteAsOf} source={commuteSource}>
      <ul class="cards cards-pane">
        {t.rows.map((r) => (
          <li>
            <a class="card" href={`/communities/${r.slug}/?base=${base.slug}`}>
              <span><span class="card-name">{r.name}</span><span class="card-sub">{r.corridor}</span></span>
              <span class="row-min">{minutes(r.drive)}</span>
            </a>
          </li>
        ))}
      </ul>
    </FactBlock>
  ))}
  {missing > 0 && <p class="gap">{missing} {missing === 1 ? 'neighborhood has' : 'neighborhoods have'} no 0700 drive time to {base.short} in our data.</p>}

  <h2 class="group-title" id="base-housing">Base housing</h2>
  <FactBlock id="housing-tied" title={`Tied to ${base.short} by LMH`} level={3} summary={housingSummary(tied, 'wait')} asOf={housingAsOf} source={housingSource}>
    {tied.length > 0 ? (
      <>
        <ul class="cards cards-pane">
          {tied.map((a) => (
            <li>
              <a class="card" href={`/base-housing/${a.id}/`}>
                <span><span class="card-name">{a.name}</span><span class="card-sub">{word(a.members.length)}{a.drive ? ` · ${minutes(a.drive)} drive` : ''}</span></span>
                <span class="row-min">{a.waitRange ? `${range(a.waitRange[0], a.waitRange[1])} mo` : a.base_group === 'PENDLETON' ? 'Not in our data' : 'Not listed'}</span>
              </a>
            </li>
          ))}
        </ul>
        {base.code === 'PENDLETON'
          ? <p class="note">Camp Pendleton's wait times aren't in our data: the Navy Housing Service Center's list covers the San Diego complex only. <a href="/base-housing/camp-pendleton/">See the Camp Pendleton area page</a> for its communities and who to ask.</p>
          : <p class="note">Wait is the range across every list, pay grade and bedroom count in the area. {estimate}.</p>}
      </>
    ) : (
      <p class="gap">Liberty Military Housing doesn't tie any base housing area to {base.short}. The areas under "Not tied to a specific base by LMH" are open to any eligible family; they're sorted by the drive here.</p>
    )}
  </FactBlock>

  <FactBlock id="housing-untied" title="Not tied to a specific base by LMH" level={3} summary={housingSummary(untied, 'drive')} asOf={housingAsOf} source={housingSource}>
    <ul class="cards cards-pane">
      {untied.map((a) => (
        <li>
          <a class="card" href={`/base-housing/${a.id}/`}>
            <span><span class="card-name">{a.name}</span><span class="card-sub">{word(a.members.length)}{a.drive ? ` · ${minutes(a.drive)} drive` : ''}</span></span>
            <span class="row-min">{a.waitRange ? `${range(a.waitRange[0], a.waitRange[1])} mo` : 'Not listed'}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="note">Wait is the range across every list, pay grade and bedroom count in the area. {estimate}. <a href="/base-housing/">All base housing</a></p>
  </FactBlock>
  </div>
  </div>
</Base>
