---
// /ask/ moved to the home page (v1.0.0). Cloudflare answers /ask/ with a 301 (public/_redirects); this page is the
// fallback anywhere else (astro preview, a saved link opened from disk): a meta refresh, and a link for anyone
// whose browser doesn't follow it.
import Base from '../layouts/Base.astro';
---

<Base title="Ask" back={{ href: '/', label: 'Home' }} description="The assistant is on the home page.">
  <meta slot="head" http-equiv="refresh" content="0; url=/" />
  <link slot="head" rel="canonical" href="/" />
  <h1>The assistant moved</h1>
  <p class="intro">Ask your question on the <a href="/" data-ask-moved>home page</a>.</p>
</Base>
