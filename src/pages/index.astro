---
// Home: ask first (v1.0.0). The same page on a phone and a desktop: the headline and sub line, the ask box, example
// questions, the region map, and the footer line on where answers come from. The conversation happens here (it
// replaced /ask/). Everything else is in the menu (src/lib/menu.ts) and on /browse/.
//
// Questions go to /api/ask on this site (functions/api/ask.js), which answers only from this site's pages. The
// conversation lives in this page's memory: no cookies; reload and it's gone. With each question go the previous
// turn (last question and answer, nothing older) and, while the chip at the bottom left of the box is on, the
// reader's move from their starting-plan answers: base, pay band and household only (assistant/context.js, v1.1.0).
// "What's sent?" lists exactly that before it's sent. The × on the chip leaves it off. scripts/check_intake.mjs
// allows this page one network call, that POST, and nothing else (intake-network).
import Base from '../layouts/Base.astro';
import SiteMap from '../components/SiteMap.astro';
import { EXAMPLE_QUESTIONS } from '../lib/examples';

const HOME_FOOTER = 'Every answer cites its official source and date. No ads, no referrals. This site stores nothing you type.';
---

<Base title="Home" description="Ask about moving to San Diego on military orders. Every answer cites its official source and date." footerNote={HOME_FOOTER}>
  <section class="start" data-start aria-labelledby="start-title">
    <div class="start-hero" data-hero>
      <h1 id="start-title">Orders to San Diego?</h1>
      <p class="start-sub">Ask about housing, BAH, schools, the commute or the paperwork. Answers come only from this guide’s dated pages.</p>
    </div>

    <noscript><p class="gap">The assistant needs JavaScript. Everything it knows is on the pages: <a href="/browse/">browse the guide</a>.</p></noscript>

    <div class="ask" data-ask hidden>
      <ol class="ask-log" data-log aria-label="Conversation"></ol>
      <p class="vh" role="status" data-status></p>

      <div class="ask-box" data-box>
        <label class="ask-label" for="ask-q" data-ask-label>Ask a question</label>
        <div class="ask-field">
          <textarea id="ask-q" rows="2" maxlength="500" data-q aria-describedby="ask-hint ask-count"></textarea>
          <div class="ask-bar">
            <div class="ctx" data-ctx>
              <a class="ctx-chip ctx-add" href="/plan/" data-ctx-add>+ Add your move</a>
              <div class="ctx-set" data-ctx-set hidden>
                <button type="button" class="ctx-chip" data-ctx-btn aria-label="Your move" aria-expanded="false" aria-controls="ctx-menu"><span class="ctx-text" data-ctx-text></span></button>
                <div class="ctx-menu" id="ctx-menu" data-ctx-menu hidden>
                  <p class="ctx-menu-head" data-ctx-full></p>
                  <ul>
                    <li data-ctx-on-item hidden><button type="button" data-ctx-on>Send it with my questions</button></li>
                    <li><a href="/plan/">See your plan</a></li>
                    <li><a href="/plan/#edit">Edit answers</a></li>
                    <li><button type="button" data-ctx-clear>Clear</button></li>
                  </ul>
                </div>
                <button type="button" class="ctx-x" data-ctx-x aria-label="Don’t send your move with the next question"><span aria-hidden="true">×</span></button>
              </div>
            </div>
            <button type="button" class="ask-send" data-send>Ask</button>
          </div>
        </div>
        <p class="vh" id="ask-hint">Enter sends; Shift and Enter starts a new line.</p>
        <div class="ask-tools">
          <span class="ask-count" id="ask-count" data-count hidden></span>
          <button type="button" class="ask-link" data-whats-sent aria-expanded="false" aria-controls="ask-sent">What’s sent?</button>
          <button type="button" class="ask-link" data-clear-log hidden>New conversation</button>
        </div>
        <p class="gap" data-error role="alert" hidden></p>
      </div>

      {/* Under the box, not in it: the box sticks to the bottom of the screen in a conversation, so the panel scrolls
          with the page instead of covering the answer. */}
      <div class="ask-sent" id="ask-sent" data-sent-panel hidden>
        <p>Your question goes to an AI model, which answers only from this guide’s pages. This site doesn’t store it. Don’t type names, addresses or anything personal.</p>
        <p>With your next question, exactly these fields go:</p>
        <ul class="ask-sent-fields" data-sent-fields></ul>
        <p data-sent-move></p>
        <pre class="ask-pre" data-context-json></pre>
      </div>

      <div class="ask-examples" data-examples>
        <p class="ask-examples-title" id="examples-title">Try one</p>
        <ul aria-labelledby="examples-title">
          {EXAMPLE_QUESTIONS.map((q) => <li><button type="button" class="ask-chip" data-example>{q.text}</button></li>)}
        </ul>
      </div>
    </div>
  </section>

  <div class="home-map" data-home-map>
    <SiteMap kind="overview" />
  </div>
</Base>

<script>
  import { parseAnswer } from '../../assistant/format.js';
  import { latestDate, relatedPage, followUps } from '../lib/askView.js';
  import { contextFromAnswers, chipSummary, contextLines, requestBody } from '../../assistant/context.js';

  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const start = $('[data-start]');
  const root = $('[data-ask]');
  const log = $('[data-log]');
  const status = $('[data-status]');
  const q = $<HTMLTextAreaElement>('[data-q]');
  const sendBtn = $<HTMLButtonElement>('[data-send]');
  const sentBtn = $<HTMLButtonElement>('[data-whats-sent]');
  const sentPanel = $('[data-sent-panel]');
  const clearBtn = $<HTMLButtonElement>('[data-clear-log]');
  const errorBox = $('[data-error]');
  const label = $('[data-ask-label]');
  root.hidden = false;

  // The chip: the reader's move from their starting-plan answers in this browser (assistant/context.js). Empty, it's
  // "+ Add your move", a link into the plan. Set, it shows base · pay band · household and goes with every question
  // until the × turns it off. The off switch is kept with the answers (`chip_off` in the same entry), so a reload
  // keeps it off; clearing the answers drops it.
  const KEY = 'pcs-sd:intake';
  const stored = () => { try { return JSON.parse(localStorage.getItem(KEY) ?? 'null'); } catch { return null; } };
  const readContext = () => contextFromAnswers(stored()?.answers);
  const storeOff = (off: boolean) => {
    const entry = stored();
    if (!entry) return;
    if (off) entry.chip_off = true;
    else delete entry.chip_off;
    try { localStorage.setItem(KEY, JSON.stringify(entry)); } catch { /* storage blocked: off for this visit only */ }
  };
  const ctxState = { included: stored()?.chip_off !== true };
  const ctxAdd = $('[data-ctx-add]');
  const ctxSet = $('[data-ctx-set]');
  const ctxBtn = $<HTMLButtonElement>('[data-ctx-btn]');
  const ctxX = $<HTMLButtonElement>('[data-ctx-x]');
  const ctxMenu = $('[data-ctx-menu]');
  const sentContext = () => (ctxState.included ? readContext() : null);
  const renderChip = () => {
    const c = readContext();
    const sum = chipSummary(c);
    ctxAdd.hidden = !!c;
    ctxSet.hidden = !c;
    if (sum) {
      const on = ctxState.included;
      $('[data-ctx-text]').textContent = on ? sum.short : 'Your move: off';
      ctxBtn.setAttribute('aria-label', on ? `Your move, sent with your questions: ${sum.short}` : `Your move: off. Not sent with your questions: ${sum.short}`);
      $('[data-ctx-full]').textContent = on ? `Sent with your questions: ${sum.full}.` : `Not sent with your questions: ${sum.full}.`;
      ctxSet.classList.toggle('off', !on);
      ctxX.hidden = !on;
      $('[data-ctx-on-item]').hidden = on;
    }
    if (!sentPanel.hidden) showOutgoing();
  };
  const setMenu = (open: boolean, focusBtn = false) => {
    ctxMenu.hidden = !open;
    ctxBtn.setAttribute('aria-expanded', String(open));
    if (focusBtn) ctxBtn.focus();
  };
  ctxBtn.addEventListener('click', () => setMenu(ctxMenu.hidden));
  ctxSet.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !ctxMenu.hidden) { e.preventDefault(); setMenu(false, true); } });
  ctxSet.addEventListener('focusout', (e) => { if (!ctxSet.contains(e.relatedTarget as Node)) setMenu(false); });
  document.addEventListener('click', (e) => { if (!ctxSet.contains(e.target as Node)) setMenu(false); });
  ctxX.addEventListener('click', () => {
    ctxState.included = false;
    storeOff(true);
    renderChip();
    ctxBtn.focus();
    status.textContent = 'Your move won’t go with your next question.';
  });
  $('[data-ctx-on]').addEventListener('click', () => {
    ctxState.included = true;
    storeOff(false);
    setMenu(false);
    renderChip();
    ctxBtn.focus();
    status.textContent = 'Your move goes with your questions again.';
  });
  $('[data-ctx-clear]').addEventListener('click', () => {
    if (!confirm('Clear your starting-plan answers from this browser?')) return;
    try { localStorage.removeItem(KEY); } catch { /* storage blocked */ }
    ctxState.included = true;
    setMenu(false);
    renderChip();
    ctxAdd.focus();
    status.textContent = 'Your starting-plan answers are cleared from this browser.';
  });
  // Another tab may change or clear the answers, or switch the chip off or on.
  addEventListener('storage', (e) => {
    if (e.key !== KEY && e.key !== null) return;
    ctxState.included = stored()?.chip_off !== true;
    renderChip();
  });
  // The plan's "Ask about this plan" lands here with the box focused.
  const fromPlan = location.hash === '#ask-with-plan';

  // The conversation: this page's memory only.
  type Reply = Record<string, any>;
  const history: { question: string; reply: Reply }[] = [];

  // What goes with a question: the previous turn (last question and the answer shown, nothing older) and, while the
  // chip is on, its context. "What's sent?" lists this same body, and send() sends it.
  const previousTurn = () => {
    const last = history.at(-1);
    if (!last) return null;
    return last.reply.answer ? { question: last.question, answer: last.reply.answer } : { question: last.question };
  };
  const showOutgoing = () => {
    const prev = previousTurn();
    const c = sentContext();
    const ul = $('[data-sent-fields]');
    ul.replaceChildren();
    // Plain labels; data-field names the field each line stands for (scripts/check_frontend_browser.mjs reads it).
    const item = (field: string, label: string, value?: string, note?: string) => {
      const li = el('li');
      li.dataset.field = field;
      li.append(el('strong', undefined, label));
      if (value) li.append(`: ${value}`);
      if (note) li.append(el('span', 'muted', ` (${note})`));
      ul.append(li);
    };
    item('question', 'Your question');
    if (prev) item('previous', 'Previous turn', 'your last question and the answer you saw', 'nothing older; start a new conversation to send none');
    for (const [field, lbl, value] of contextLines(c)) item(`context.${field}`, lbl, value);
    const have = readContext();
    $('[data-sent-move]').textContent = !have
      ? 'No starting-plan answers in this browser, so none go. Add your move to get answers fitted to your base, pay grade and household.'
      : c ? 'From your starting-plan answers, only these go: the summary on the chip. Your timeline, bedrooms, pets and priorities stay in this browser. Tap × on the chip to leave it off.'
      : 'Your move is off, so none of your starting-plan answers go with your questions. Tap the chip to send it again.';
    // The previous answer is shown cut to about 200 characters; all of it goes.
    const shownPrev = prev?.answer && prev.answer.length > PREVIEW ? { ...prev, answer: `${clip(prev.answer)} (full text sent, ${prev.answer.length} characters)` } : prev;
    $('[data-context-json]').textContent = JSON.stringify(requestBody(q.value.trim() || '…', shownPrev, c), null, 2);
  };
  const PREVIEW = 200;
  const clip = (t: string) => `${t.slice(0, PREVIEW).replace(/\s+\S*$/, '')}…`;
  sentBtn.addEventListener('click', () => {
    const open = sentPanel.hidden;
    sentPanel.hidden = !open;
    sentBtn.setAttribute('aria-expanded', String(open));
    if (open) { showOutgoing(); sentPanel.scrollIntoView({ block: 'nearest', behavior: reduced ? 'auto' : 'smooth' }); }
  });
  // From 400 of the 500 characters the box allows, a counter shows (and the box's description reads it).
  const counter = $('[data-count]');
  const count = () => {
    const n = q.value.length;
    counter.hidden = n < 400;
    counter.replaceChildren(...(n < 400 ? [] : [`${n}/500`, el('span', 'vh', ' characters')]));
  };
  q.addEventListener('input', () => {
    count();
    if (q.value.trim() && errorBox.dataset.kind === 'empty') errorBox.hidden = true;
    if (!sentPanel.hidden) showOutgoing();
  });

  const el = (tag: string, cls?: string, text?: string) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  };
  const link = (href: string, text: string, cls?: string) => {
    const a = el('a', cls, text) as HTMLAnchorElement;
    a.href = href;
    return a;
  };
  // Links out of the conversation open in a new tab, so Back never loses it (the conversation is in this page only).
  const newTab = (a: HTMLAnchorElement) => {
    a.target = '_blank';
    a.rel = 'noopener';
    a.append(el('span', 'vh', ' (opens in a new tab)'));
    return a;
  };
  // A server-sent URL becomes a link only if it is this site's own path or http(s); anything else stays text.
  const safeHref = (href: unknown) => {
    if (typeof href !== 'string') return null;
    try {
      const u = new URL(href, location.href);
      return u.protocol === 'https:' || u.protocol === 'http:' ? href : null;
    } catch { return null; }
  };
  // An answer's bold, lists and site links (assistant/format.js); everything else stays text.
  const fill = (parent: HTMLElement, tokens: { type: string; text: string; href?: string }[]) => {
    for (const t of tokens) {
      if (t.type === 'strong') parent.append(el('strong', undefined, t.text));
      else if (t.type === 'link') parent.append(newTab(link(t.href!, t.text)));
      else parent.append(t.text);
    }
  };
  const answerText = (text: string) => {
    const box = el('div', 'ask-text');
    for (const b of parseAnswer(text)) {
      if (b.type === 'p') { const p = el('p'); fill(p, b.inline); box.append(p); continue; }
      const list = el(b.type);
      for (const item of b.items) { const li = el('li'); fill(li, item); list.append(li); }
      box.append(list);
    }
    return box;
  };
  // The receipts, collapsed: "N sources · verified <latest>", opening to each cited section with its date.
  const sourceChip = (citations: Reply[]) => {
    const d = el('details', 'src-chip ask-src');
    const latest = latestDate(citations);
    const n = citations.length;
    d.append(el('summary', undefined, `${n} ${n === 1 ? 'source' : 'sources'}${latest ? ` · verified ${latest}` : ''}`));
    const body = el('div', 'src-chip-body');
    const ul = el('ul', 'ask-src-list');
    for (const c of citations) {
      const li = el('li');
      const href = safeHref(c.url);
      const label = c.label ?? `${c.title}: ${c.section}`;
      li.append(href ? newTab(link(href, label)) : el('span', undefined, label));
      if (c.verified_on) li.append(el('span', 'muted', ` · verified ${c.verified_on}`));
      ul.append(li);
    }
    body.append(ul);
    d.append(body);
    return d;
  };
  const relatedCard = (r: { url: string; title: string; sub?: string }) => {
    const href = safeHref(r.url);
    if (!href) return null;
    const a = link(href, '', 'card ask-related');
    const words = el('span');
    words.append(el('span', 'card-eyebrow', 'Related page'), el('span', 'card-name', r.title));
    if (r.sub) words.append(el('span', 'card-sub', r.sub));
    const arrow = el('span', 'arrow', '›');
    arrow.setAttribute('aria-hidden', 'true');
    a.append(words, arrow);
    return newTab(a);
  };
  const answerBlock = (question: string, reply: Reply) => {
    const a = el('div', 'ask-answer');
    if (reply.answer) a.append(answerText(reply.answer));
    if (reply.note) a.append(el('p', 'note', reply.note));
    // Only the sections the answer cites, under the label it cites them by (assistant/cite.js).
    if (reply.citations?.length) a.append(sourceChip(reply.citations));
    const related = relatedPage(reply);
    const card = related && relatedCard(related);
    if (card) a.append(card);
    if (reply.prompt) {
      const d = el('details', 'ask-stub');
      d.append(el('summary', undefined, 'The prompt that would go to the model'));
      d.append(el('pre', 'ask-pre', `${reply.prompt.system}\n\n=== user ===\n\n${reply.prompt.messages[0].content}`));
      a.append(d);
    }
    // Follow-ups from the cited sections (src/lib/askView.js): no model call.
    const next = followUps(reply, question);
    if (next.length) {
      const wrap = el('div', 'ask-next');
      const ul = el('ul');
      ul.setAttribute('aria-label', 'Follow-up questions');
      for (const s of next) {
        const li = el('li');
        const b = el('button', 'ask-chip ask-chip-small', s) as HTMLButtonElement;
        b.type = 'button';
        b.addEventListener('click', () => ask(s));
        li.append(b);
        ul.append(li);
      }
      wrap.append(ul);
      a.append(wrap);
    }
    return a;
  };

  // Conversation mode: the start screen gives way to the log, and the box becomes the follow-up box.
  const setTalking = (on: boolean) => {
    start.classList.toggle('talking', on);
    $('[data-examples]').hidden = on;
    clearBtn.hidden = !on;
    // The site name goes home, which ends the conversation: say so while there is one.
    $('[data-site-sub]').hidden = !on;
    label.textContent = on ? 'Ask a follow-up' : 'Ask a question';
  };
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // An error under the box. `kind` says which ("empty" goes away as soon as there's text).
  const showError = (kind: string, ...parts: (string | Node)[]) => {
    errorBox.replaceChildren(...parts);
    errorBox.dataset.kind = kind;
    errorBox.hidden = false;
  };
  const browse = () => link('/browse/', 'browse the pages');
  // What the reader sees when /api/ask answers with an error (assistant/ask.js, functions/api/ask.js). The daily cap
  // (429) and "isn't working" (502: the model provider refused the call, which is what a spend limit or billing stop
  // looks like) last, so they point to the pages, which hold everything the assistant knows.
  const serverError = (status: number, reply: Reply) => {
    const text: string = typeof reply.error === 'string' && reply.error ? reply.error
      : status === 503 ? 'The assistant is busy. Try again in a minute.' : 'The assistant isn’t working right now.';
    const at = text.indexOf('browse the pages');
    if (at >= 0) return [text.slice(0, at), browse(), text.slice(at + 'browse the pages'.length)];
    if (status === 503) return [text];
    return [`${text} Everything it knows is on the guide’s pages: `, browse(), '.'];
  };
  const TIMEOUT_MS = 45_000;
  let busy = false;
  // Each conversation has a number; "New conversation" moves to the next and cancels what's pending, so a reply
  // that arrives late for a cleared conversation is dropped, never shown and never sent as the previous turn.
  let convo = 0;
  let pending: AbortController | null = null;
  const ask = async (text?: string) => {
    if (busy) return;
    const question = (text ?? q.value).trim();
    if (!question) { showError('empty', 'Type a question.'); q.focus(); return; }
    busy = true;
    const gen = convo;
    const ctrl = new AbortController();
    pending = ctrl;
    let timedOut = false;
    const timer = setTimeout(() => { timedOut = true; ctrl.abort(); }, TIMEOUT_MS);
    errorBox.hidden = true;
    sendBtn.disabled = true;
    const outgoing = requestBody(question, previousTurn(), sentContext());
    setTalking(true);
    const li = el('li', 'ask-turn');
    li.append(el('p', 'ask-you', question));
    const waiting = el('div', 'ask-answer ask-waiting');
    waiting.append(el('p', 'ask-checking', 'Checking the sources…'));
    li.append(waiting);
    log.append(li);
    status.textContent = 'Checking the sources…';
    q.value = '';
    count();
    li.scrollIntoView({ block: 'start', behavior: reduced ? 'auto' : 'smooth' });
    // No answer: the turn goes, the question goes back in the box (unless something new was typed there), the error
    // shows under the box, and nothing is kept as the previous turn.
    const failed = (kind: string, parts: (string | Node)[]) => {
      li.remove();
      if (!log.children.length) setTalking(false);
      if (!q.value.trim()) q.value = question;
      count();
      showError(kind, ...parts);
      status.textContent = '';
      q.focus();
    };
    try {
      const res = await fetch('/api/ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(outgoing),
        signal: ctrl.signal,
      });
      const reply: Reply = await res.json().catch(() => ({}));
      if (gen !== convo) return;
      if (!res.ok || reply.error || !(reply.answer || reply.note)) { failed('server', serverError(res.status, reply)); return; }
      history.push({ question, reply });
      const block = answerBlock(question, reply);
      block.tabIndex = -1;
      waiting.replaceWith(block);
      // Focus moves to the answer, and the status region reads it.
      block.focus({ preventScroll: true });
      const said = (block.querySelector('.ask-text')?.textContent ?? reply.note ?? '').replace(/\s+/g, ' ').trim();
      status.textContent = said ? `Answer: ${said}` : 'Answer ready.';
    } catch {
      if (gen !== convo) return;
      failed(timedOut ? 'timeout' : 'network', [timedOut
        ? 'The assistant took too long to answer. Your question is still in the box: press Ask to try again.'
        : 'Couldn’t reach the assistant. Check your connection and try again.']);
    } finally {
      clearTimeout(timer);
      if (gen === convo) {
        busy = false;
        pending = null;
        sendBtn.disabled = false;
        showOutgoing();
      }
    }
  };
  sendBtn.addEventListener('click', () => ask());
  q.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); ask(); } });
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-example]')) b.addEventListener('click', () => ask(b.textContent ?? ''));
  clearBtn.addEventListener('click', () => {
    convo++;
    pending?.abort();
    pending = null;
    busy = false;
    sendBtn.disabled = false;
    history.length = 0;
    log.replaceChildren();
    errorBox.hidden = true;
    setTalking(false);
    showOutgoing();
    status.textContent = 'New conversation.';
    q.focus();
  });
  renderChip();
  if (fromPlan) q.focus();
</script>
